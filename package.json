{
  "name": "yt-thumbnail-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "Download YouTube thumbnails in any available quality",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./public/style.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./public/style.css --watch",
    "serve": "serve public -l 3000",
    "dev": "concurrently -k \"npm:watch\" \"npm:serve\"",
    "start": "npm run build && npm run serve"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17"
  }
}
